# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values below.
# Everything here is SERVER-ONLY — do NOT prefix any of it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Lead delivery (contact form + insurance verification form)   [REQUIRED]
# ---------------------------------------------------------------------------
# Both forms POST to a Server Action which forwards the lead as JSON to this
# endpoint. Without it, submissions FAIL VISIBLY in production and the form
# tells the visitor to call instead — it will never silently drop a lead.
#
# *** HIPAA ***
# The insurance form collects PHI: full name, date of birth, insurance provider
# and member/policy ID. This endpoint MUST be covered by a Business Associate
# Agreement. A generic inbox, a Zapier/Make webhook, or a marketing-automation
# endpoint is NOT sufficient. Use a HIPAA-eligible form/CRM provider.
LEAD_WEBHOOK_URL=

# Optional: sent as `Authorization: Bearer <token>` with each lead POST.
LEAD_WEBHOOK_TOKEN=


# ---------------------------------------------------------------------------
# Google Reviews (homepage "They trusted us. So can you." section)  [OPTIONAL]
# ---------------------------------------------------------------------------
# Without GOOGLE_PLACES_API_KEY the reviews section simply does not render
# (no empty placeholder, no build error).

# A Google Cloud API key with the "Places API (New)" enabled.
# https://console.cloud.google.com/  → APIs & Services → Enable "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Optional but recommended: the Google Place ID for Wellness Detox of LA.
# https://developers.google.com/maps/documentation/places/web-service/place-id
# If left blank, it is resolved automatically from the business name + address.
GOOGLE_PLACE_ID=
